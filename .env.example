NODE_ENV=development
API_PORT=4000
# Comma-separated browser origins allowed to call the API
APP_ORIGIN=http://localhost:3000,http://192.168.1.40:3000
DATABASE_URL=mysql://root:@127.0.0.1:3306/nacira_crm
TEST_DATABASE_URL=mysql://root:@127.0.0.1:3306/nacira_crm_test
# 64+ random hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# AI provider keys (server-side only)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Read-only e-report integration (token from `php artisan integration:create-client`)
EREPORT_API_URL=https://api-ereport.interiorcustom.id
EREPORT_API_TOKEN=
# 0 disables the background sync scheduler
EREPORT_SYNC_INTERVAL_MINUTES=15
