{
  "name": "nacira-sales-ai-crm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host",
    "dev:api": "tsx watch --env-file=.env server/src/index.ts",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:api\"",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node --env-file=.env dist-server/server/src/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env server/src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env server/src/db/seed.ts",
    "test:api": "tsx --env-file=.env --test --test-concurrency=1 server/tests/*.test.ts",
    "user:create": "tsx --env-file=.env server/src/db/create-user.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.24.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.2.0"
  }
}
